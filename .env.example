# Copy this file to .env and fill in the MySQL database you created.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vms
DB_PASSWORD=change-me
DB_NAME=vms

# Required. Use a long random value. The API will not start without it.
JWT_SECRET=replace-with-a-long-random-secret

PORT=4000
FACE_SERVICE_URL=http://127.0.0.1:8090

# Leave unset or "none" until a real SMTP provider is connected.
# Password reset returns an unavailable error instead of claiming an email was sent.
EMAIL_PROVIDER=none
